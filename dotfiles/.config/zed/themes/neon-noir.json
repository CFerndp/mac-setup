{
  "$schema": "https://zed.dev/schema/themes/v0.2.0.json",
  "name": "Neon Noir",
  "author": "mac-setup",
  "themes": [
    {
      "name": "Neon Noir",
      "appearance": "dark",
      "style": {
        "background": "#0b0b12ff",
        "surface.background": "#0f0f18ff",
        "elevated_surface.background": "#14141fff",
        "panel.background": "#0b0b12ff",
        "panel.focused_border": "#ff2a6dff",
        "editor.background": "#0b0b12ff",
        "editor.foreground": "#d7d7e8ff",
        "editor.gutter.background": "#0b0b12ff",
        "editor.active_line.background": "#14141fff",
        "editor.highlighted_line.background": "#1f1f2eff",
        "editor.line_number": "#3a3a52ff",
        "editor.active_line_number": "#ff2a6dff",
        "editor.indent_guide": "#1f1f2eff",
        "editor.indent_guide_active": "#3a1f4fff",
        "editor.wrap_guide": "#1f1f2eff",
        "editor.document_highlight.read_background": "#05d9e81f",
        "editor.document_highlight.write_background": "#ff2a6d1f",
        "search.match_background": "#b967ff40",
        "title_bar.background": "#0b0b12ff",
        "title_bar.inactive_background": "#0b0b12ff",
        "status_bar.background": "#0b0b12ff",
        "toolbar.background": "#0b0b12ff",
        "tab_bar.background": "#0b0b12ff",
        "tab.active_background": "#14141fff",
        "tab.inactive_background": "#0b0b12ff",
        "border": "#1f1f2eff",
        "border.variant": "#14141fff",
        "border.focused": "#ff2a6dff",
        "border.selected": "#b967ffff",
        "text": "#d7d7e8ff",
        "text.muted": "#6c6c8aff",
        "text.placeholder": "#4a4a63ff",
        "text.accent": "#05d9e8ff",
        "icon": "#d7d7e8ff",
        "icon.muted": "#6c6c8aff",
        "icon.accent": "#ff2a6dff",
        "element.background": "#14141fff",
        "element.hover": "#1f1f2eff",
        "element.selected": "#3a1f4fff",
        "element.active": "#3a1f4fff",
        "ghost_element.hover": "#1f1f2eff",
        "ghost_element.selected": "#3a1f4fff",
        "ghost_element.active": "#3a1f4fff",
        "scrollbar.track.background": "#0b0b1200",
        "scrollbar.thumb.background": "#b967ff40",
        "scrollbar.thumb.hover_background": "#b967ff80",
        "link_text.hover": "#05d9e8ff",
        "error": "#ff2a6dff",
        "warning": "#f3e600ff",
        "success": "#00ff9fff",
        "info": "#05d9e8ff",
        "hint": "#6c6c8aff",
        "created": "#00ff9fff",
        "modified": "#f3e600ff",
        "deleted": "#ff2a6dff",
        "conflict": "#b967ffff",
        "terminal.background": "#0b0b12ff",
        "terminal.foreground": "#d7d7e8ff",
        "terminal.ansi.black": "#1a1a24ff",
        "terminal.ansi.red": "#ff2a6dff",
        "terminal.ansi.green": "#00ff9fff",
        "terminal.ansi.yellow": "#f3e600ff",
        "terminal.ansi.blue": "#3d7bffff",
        "terminal.ansi.magenta": "#b967ffff",
        "terminal.ansi.cyan": "#05d9e8ff",
        "terminal.ansi.white": "#d7d7e8ff",
        "terminal.ansi.bright_black": "#4a4a63ff",
        "terminal.ansi.bright_red": "#ff5c8aff",
        "terminal.ansi.bright_green": "#5cffb8ff",
        "terminal.ansi.bright_yellow": "#fff35cff",
        "terminal.ansi.bright_blue": "#6b9bffff",
        "terminal.ansi.bright_magenta": "#d199ffff",
        "terminal.ansi.bright_cyan": "#5ef1ffff",
        "terminal.ansi.bright_white": "#ffffffff",
        "players": [
          { "cursor": "#ff2a6dff", "selection": "#3a1f4fcc", "background": "#ff2a6dff" },
          { "cursor": "#05d9e8ff", "selection": "#05d9e833", "background": "#05d9e8ff" },
          { "cursor": "#b967ffff", "selection": "#b967ff33", "background": "#b967ffff" }
        ],
        "syntax": {
          "comment": { "color": "#4a4a63ff", "font_style": "italic" },
          "comment.doc": { "color": "#6c6c8aff", "font_style": "italic" },
          "keyword": { "color": "#ff2a6dff", "font_weight": 700 },
          "string": { "color": "#00ff9fff" },
          "string.escape": { "color": "#05d9e8ff" },
          "string.regex": { "color": "#f3e600ff" },
          "number": { "color": "#f3e600ff" },
          "boolean": { "color": "#f3e600ff" },
          "constant": { "color": "#f3e600ff" },
          "function": { "color": "#05d9e8ff" },
          "function.method": { "color": "#05d9e8ff" },
          "constructor": { "color": "#b967ffff" },
          "type": { "color": "#b967ffff" },
          "type.builtin": { "color": "#d199ffff" },
          "variable": { "color": "#d7d7e8ff" },
          "variable.special": { "color": "#ff5c8aff", "font_style": "italic" },
          "property": { "color": "#5ef1ffff" },
          "attribute": { "color": "#d199ffff" },
          "tag": { "color": "#ff2a6dff" },
          "operator": { "color": "#ff5c8aff" },
          "punctuation": { "color": "#6c6c8aff" },
          "punctuation.bracket": { "color": "#8a8aa8ff" },
          "punctuation.delimiter": { "color": "#6c6c8aff" },
          "title": { "color": "#ff2a6dff", "font_weight": 700 },
          "emphasis": { "color": "#05d9e8ff", "font_style": "italic" },
          "emphasis.strong": { "color": "#ff2a6dff", "font_weight": 700 },
          "link_uri": { "color": "#05d9e8ff" },
          "link_text": { "color": "#b967ffff" }
        }
      }
    }
  ]
}
