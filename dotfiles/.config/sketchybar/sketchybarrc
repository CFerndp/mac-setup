#!/bin/bash
# SketchyBar al estilo de la Waybar de Omarchy, con los escritorios de AeroSpace.
# Tema Neon Noir (colors.sh). La barra es transparente y los iconos se agrupan en
# "islas" (brackets) con fondo propio, como en la config de FelixKratz.
# Filosofía: solo iconos; el dato al pasar el ratón; el clic lleva a más.

export PATH="/opt/homebrew/bin:$PATH"
source "$CONFIG_DIR/colors.sh"
PLUGIN_DIR="$CONFIG_DIR/plugins"
HELPERS="$CONFIG_DIR/helpers"
FONT="JetBrainsMono Nerd Font"
HOVER="mouse.entered mouse.exited"

sketchybar --bar position=top height=32 y_offset=6 margin=10 \
                 color=0x00000000 border_width=0 shadow=off \
                 display=all topmost=on padding_left=0 padding_right=0

sketchybar --default updates=when_shown \
                     icon.font="$FONT:Bold:15.0" label.font="$FONT:Bold:13.0" \
                     icon.color=$TEXT label.color=$TEXT \
                     padding_left=2 padding_right=2 \
                     icon.padding_left=6 icon.padding_right=6 \
                     label.padding_left=0 label.padding_right=8

# Estilo común
ISLAND="background.color=$BAR_COLOR background.corner_radius=12 background.height=30 \
        background.border_width=1 background.border_color=$BAR_BORDER"
POPUP="popup.background.color=$BG popup.background.corner_radius=12 \
       popup.background.border_width=1 popup.background.border_color=$VIOLET \
       popup.blur_radius=30 popup.y_offset=6"

island() { # island <nombre> <miembros...>
  local name="$1"; shift
  sketchybar --add bracket "$name" "$@" --set "$name" $ISLAND
}

gap() { # gap <nombre> <left|right>: separación entre islas
  sketchybar --add item "$1" "$2" --set "$1" width=8 icon.drawing=off label.drawing=off
}

# ============================== Izquierda ==============================

# --- Escritorios de AeroSpace: una isla por pantalla ---
sketchybar --add event aerospace_workspace_change

for mid in $(aerospace list-monitors --format '%{monitor-id}'); do
  display=$(aerospace list-monitors --format '%{monitor-id} %{monitor-appkit-nsscreen-screens-id}' \
            | awk -v m="$mid" '$1 == m { print $2 }')
  members=()
  for sid in $(aerospace list-workspaces --monitor "$mid"); do
    sketchybar --add item space.$sid left \
               --set space.$sid display=$display \
                     padding_left=3 padding_right=3 \
                     icon="$sid" icon.padding_left=9 icon.padding_right=9 \
                     label.font="sketchybar-app-font:Regular:14.0" \
                     label.padding_left=0 label.padding_right=9 label.y_offset=-1 \
                     background.color=$MAGENTA background.corner_radius=10 \
                     background.height=24 background.drawing=off \
                     click_script="aerospace workspace $sid"
    members+=(space.$sid)
  done
  island "spaces.m$mid" "${members[@]}"
done

# Un solo script pinta todos los escritorios
sketchybar --add item spaces.observer left \
           --subscribe spaces.observer aerospace_workspace_change front_app_switched space_windows_change \
           --set spaces.observer drawing=off updates=on script="$PLUGIN_DIR/spaces.sh"

gap gap.left1 left

# --- App activa + sus menús (clic en la app = alternar escritorios / menús) ---
sketchybar --add item front_app left \
           --subscribe front_app front_app_switched mouse.clicked $HOVER \
           --set front_app display=active \
                 icon.font="sketchybar-app-font:Regular:14.0" icon.color=$CYAN \
                 label.color=$CYAN label.font="$FONT:Bold Italic:13.0" \
                 script="$PLUGIN_DIR/front_app.sh"

for i in $(seq 1 15); do
  sketchybar --add item menu.$i left \
             --set menu.$i display=active drawing=off icon.drawing=off \
                   label.padding_left=7 label.padding_right=7 \
                   label.font="$FONT:$([ $i = 1 ] && echo Bold || echo Regular):13.0" \
                   click_script="$HELPERS/menus select $i"
done
# Botón » con los menús que no caben antes del notch (lo gestiona helpers/notch.py)
sketchybar --add item menu.more left \
           --subscribe menu.more mouse.clicked mouse.exited.global \
           --set menu.more display=active drawing=off icon=󰄾 icon.color=$MAGENTA \
                 label.drawing=off script="$PLUGIN_DIR/popup.sh" $POPUP
island island.app front_app '/menu\..*/'

# =============================== Derecha ===============================
# (se añaden de derecha a izquierda)

# --- Fecha ---
sketchybar --add item clock right \
           --subscribe clock $HOVER \
           --set clock update_freq=10 icon=󰥔 icon.color=$MAGENTA \
                 script="$PLUGIN_DIR/clock.sh"
island island.clock clock
gap gap.right1 right

# --- Sistema: batería y CPU ---
sketchybar --add item battery right \
           --subscribe battery system_woke power_source_change $HOVER \
           --set battery update_freq=120 script="$PLUGIN_DIR/battery.sh" \
           --add item cpu right \
           --subscribe cpu mouse.clicked $HOVER \
           --set cpu update_freq=5 icon=󰻠 icon.color=$CYAN \
                 script="$PLUGIN_DIR/cpu.sh"
island island.system battery cpu
gap gap.right2 right

# --- Entrada / salida: red, volumen, teclado, audio ---
sketchybar --add item network right \
           --subscribe network wifi_change system_woke mouse.clicked $HOVER \
           --set network update_freq=30 script="$PLUGIN_DIR/network.sh"

sketchybar --add item volume right \
           --subscribe volume volume_change mouse.clicked mouse.scrolled mouse.exited.global $HOVER \
           --set volume icon.color=$VIOLET script="$PLUGIN_DIR/volume.sh" $POPUP

MEDIAKEY="$HELPERS/mediakey"
sketchybar --add slider volume.slider popup.volume 180 \
           --subscribe volume.slider mouse.clicked \
           --set volume.slider icon=󰕾 icon.color=$VIOLET \
                 slider.highlight_color=$MAGENTA slider.background.height=6 \
                 slider.background.corner_radius=3 slider.background.color=$SURFACE \
                 slider.knob=󰝤 slider.knob.color=$CYAN \
                 script="$PLUGIN_DIR/volume_slider.sh" \
           --add item volume.mute popup.volume \
           --set volume.mute icon=󰖁 icon.color=$MAGENTA \
                 click_script="osascript -e 'set volume output muted not (output muted of (get volume settings))'" \
           --add item volume.prev popup.volume \
           --set volume.prev icon=󰒮 icon.color=$CYAN label="Anterior" click_script="$MEDIAKEY previous" \
           --add item volume.play popup.volume \
           --set volume.play icon=󰐎 icon.color=$MAGENTA label="Reproducir / Pausa" click_script="$MEDIAKEY play" \
           --add item volume.next popup.volume \
           --set volume.next icon=󰒭 icon.color=$CYAN label="Siguiente" click_script="$MEDIAKEY next"

sketchybar --add event input_change AppleSelectedInputSourcesChangedNotification \
           --add item keyboard right \
           --subscribe keyboard input_change mouse.clicked mouse.exited.global $HOVER \
           --set keyboard icon=󰌌 icon.color=$VIOLET script="$PLUGIN_DIR/keyboard.sh" $POPUP

sketchybar --add event audio_change \
           --add item audio right \
           --subscribe audio audio_change system_woke mouse.clicked mouse.exited.global $HOVER \
           --set audio update_freq=15 icon.color=$CYAN label.color=$TEXT \
                 script="$PLUGIN_DIR/audio.sh" $POPUP

# Brillo del monitor externo (BetterDisplay); oculto si no hay monitor externo
sketchybar --add event brightness_change \
           --add item brightness right \
           --subscribe brightness brightness_change display_change mouse.clicked mouse.scrolled mouse.exited.global $HOVER \
           --set brightness update_freq=60 updates=on icon=󰃟 icon.color=$YELLOW drawing=off \
                 script="$PLUGIN_DIR/brightness.sh" $POPUP \
           --add slider brightness.slider popup.brightness 180 \
           --subscribe brightness.slider mouse.clicked \
           --set brightness.slider icon=󰃟 icon.color=$YELLOW \
                 slider.highlight_color=$YELLOW slider.background.height=6 \
                 slider.background.corner_radius=3 slider.background.color=$SURFACE \
                 slider.knob=󰝤 slider.knob.color=$CYAN \
                 script="$PLUGIN_DIR/brightness_slider.sh"

island island.io network volume keyboard audio brightness
gap gap.right3 right

# --- Herramientas: tiling, capturas, Docker y avisos sin leer ---
# Tiling de AeroSpace: clic (o SUPER+Shift+Escape) lo desactiva / activa
sketchybar --add event tiling_change \
           --add item tiling right \
           --subscribe tiling tiling_change mouse.clicked $HOVER \
           --set tiling update_freq=10 icon=󰕰 icon.color=$CYAN \
                 script="$PLUGIN_DIR/tiling.sh"

sketchybar --add item capture right \
           --subscribe capture mouse.clicked mouse.exited.global \
           --set capture icon=󰄀 icon.color=$MAGENTA label.drawing=off \
                 script="$PLUGIN_DIR/popup.sh" $POPUP
for entry in "󰩭|Área|open shottr://grab/area" \
             "󰍹|Pantalla completa|open shottr://grab/fullscreen" \
             "󰖯|Ventana activa|open shottr://grab/window/active" \
             "󰶘|Con scroll|open shottr://grab/scrolling" \
             "󰑋|Grabar pantalla|open -a Screenshot"; do
  IFS='|' read -r icon label cmd <<<"$entry"
  id="capture.$(echo "$label" | tr -cd '[:alnum:]')"
  sketchybar --add item "$id" popup.capture \
             --set "$id" icon="$icon" icon.color=$CYAN label="$label" \
                   click_script="sketchybar --set capture popup.drawing=off; sleep 0.2; $cmd"
done

# Portapapeles: abre Maccy pulsando su atajo global (Shift+Cmd+C; Maccy no tiene
# otra forma de abrirse desde fuera). Si cambias el atajo en Maccy, cambia MACCY_KEY.
MACCY_KEY="8 cmd,shift"
sketchybar --add item clipboard right \
           --subscribe clipboard $HOVER \
           --set clipboard icon=󰅌 icon.color=$CYAN \
                 click_script="$HELPERS/hotkey $MACCY_KEY" \
                 script="$PLUGIN_DIR/clipboard.sh"

sketchybar --add item docker right \
           --subscribe docker mouse.clicked mouse.exited.global $HOVER \
           --set docker update_freq=20 updates=on icon=󰡨 icon.color=$CYAN drawing=off \
                 script="$PLUGIN_DIR/docker.sh" $POPUP

for app in "Slack|slack" "Microsoft Teams|microsoft_teams" "Microsoft Outlook|microsoft_outlook"; do
  IFS='|' read -r name icon <<<"$app"
  id="notif.$icon"
  sketchybar --add item "$id" right \
             --subscribe "$id" $HOVER \
             --set "$id" drawing=off updates=on update_freq=10 \
                   icon=":$icon:" icon.font="sketchybar-app-font:Regular:14.0" \
                   icon.color=$MAGENTA label.color=$MAGENTA \
                   click_script="open -a '$name'" \
                   script="$PLUGIN_DIR/notif.sh '$name'"
done

island island.tools tiling capture clipboard docker '/notif\..*/'
gap gap.right4 right

# --- Lo que suena en el navegador ---
FOCUS_TAB='IFS="|" read -r b w t < "${TMPDIR:-/tmp}/sketchybar_media" && osascript "$CONFIG_DIR/helpers/focus_tab.scpt" "$b" "$w" "$t"'
sketchybar --add item media right \
           --subscribe media mouse.clicked mouse.exited.global $HOVER \
           --set media drawing=off updates=on update_freq=3 \
                 label.max_chars=28 scroll_texts=on \
                 script="$PLUGIN_DIR/media.sh" $POPUP \
           --add item media.title popup.media \
           --set media.title icon.drawing=off label.color=$TEXT label.font="$FONT:Bold:14.0" \
           --add item media.source popup.media \
           --set media.source icon.color=$MAGENTA label.color=$MUTED label.font="$FONT:Regular:11.0" \
           --add item media.prev popup.media \
           --set media.prev icon=󰒮 icon.color=$CYAN label="Anterior" \
                 click_script="$MEDIAKEY previous; sleep 1; sketchybar --update" \
           --add item media.play popup.media \
           --set media.play icon.color=$MAGENTA \
                 click_script="$MEDIAKEY play; sleep 1; sketchybar --update" \
           --add item media.next popup.media \
           --set media.next icon=󰒭 icon.color=$CYAN label="Siguiente" \
                 click_script="$MEDIAKEY next; sleep 1; sketchybar --update" \
           --add item media.focus popup.media \
           --set media.focus icon=󰖟 icon.color=$VIOLET label="Ir a la pestaña" \
                 click_script="sketchybar --set media popup.drawing=off; $FOCUS_TAB"
island island.media media

# =============================== Notch ===============================
# Detecta la pantalla con cámara. Si cambian las pantallas (p. ej. se quita el HDMI),
# displays.sh recarga la barra para repartir los escritorios en las que haya.
NOTCH="python3 $HELPERS/notch.py"
sketchybar --add item displays.watch left \
           --subscribe displays.watch display_change system_woke \
           --set displays.watch drawing=off updates=on \
                 script="$PLUGIN_DIR/displays.sh"

# ================================ Inicio ================================
rm -f "${TMPDIR:-/tmp}/sketchybar_menus_on"
$NOTCH detect
"$PLUGIN_DIR/displays.sh" save
sketchybar --update
sketchybar --trigger aerospace_workspace_change FOCUSED_WORKSPACE="$(aerospace list-workspaces --focused)"
