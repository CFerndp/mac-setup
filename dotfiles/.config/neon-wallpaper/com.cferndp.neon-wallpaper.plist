<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Arranca el fondo animado al iniciar sesión. wallpaper.sh lo copia a
     ~/Library/LaunchAgents cambiando HOME_DIR por tu carpeta personal. -->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.cferndp.neon-wallpaper</string>
  <key>ProgramArguments</key>
  <array>
    <string>HOME_DIR/.config/neon-wallpaper/wallpaper</string>
  </array>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>
  <key>ProcessType</key>
  <string>Interactive</string>
</dict>
</plist>
