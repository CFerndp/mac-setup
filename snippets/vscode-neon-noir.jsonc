// Tema Neon Noir para VS Code: pegar en settings.json (Cmd+Shift+P > "Open User Settings (JSON)").
// Usa el tema oscuro de VS Code con los colores encima; no hace falta ninguna extensión.
{
  "workbench.colorTheme": "Default Dark Modern",
  "workbench.colorCustomizations": {
    "[Default Dark Modern]": {
        "editor.background": "#0b0b12",
        "editor.foreground": "#d7d7e8",
        "editorCursor.foreground": "#ff2a6d",
        "editor.lineHighlightBackground": "#14141f",
        "editor.selectionBackground": "#3a1f4f",
        "editorLineNumber.foreground": "#3a3a52",
        "editorLineNumber.activeForeground": "#ff2a6d",
        "editorIndentGuide.background1": "#1f1f2e",
        "editorIndentGuide.activeBackground1": "#3a1f4f",
        "editorGutter.background": "#0b0b12",
        "editorGroupHeader.tabsBackground": "#0b0b12",
        "tab.activeBackground": "#14141f",
        "tab.inactiveBackground": "#0b0b12",
        "tab.activeBorderTop": "#ff2a6d",
        "tab.border": "#0b0b12",
        "sideBar.background": "#0b0b12",
        "sideBar.border": "#1f1f2e",
        "activityBar.background": "#0b0b12",
        "activityBar.activeBorder": "#ff2a6d",
        "activityBar.foreground": "#ff2a6d",
        "activityBar.inactiveForeground": "#6c6c8a",
        "activityBarBadge.background": "#ff2a6d",
        "titleBar.activeBackground": "#0b0b12",
        "titleBar.inactiveBackground": "#0b0b12",
        "statusBar.background": "#0b0b12",
        "statusBar.border": "#1f1f2e",
        "statusBar.foreground": "#05d9e8",
        "statusBarItem.remoteBackground": "#ff2a6d",
        "panel.background": "#0b0b12",
        "panel.border": "#1f1f2e",
        "terminal.background": "#0b0b12",
        "list.activeSelectionBackground": "#3a1f4f",
        "list.hoverBackground": "#1f1f2e",
        "list.highlightForeground": "#05d9e8",
        "focusBorder": "#ff2a6d",
        "textLink.foreground": "#05d9e8",
        "button.background": "#ff2a6d",
        "button.foreground": "#0b0b12",
        "badge.background": "#b967ff",
        "progressBar.background": "#ff2a6d",
        "scrollbarSlider.background": "#b967ff40",
        "scrollbarSlider.hoverBackground": "#b967ff80",
      }
  },
  "editor.tokenColorCustomizations": {
    "[Default Dark Modern]": {
        "comments": "#4a4a63",
        "keywords": "#ff2a6d",
        "strings": "#00ff9f",
        "numbers": "#f3e600",
        "functions": "#05d9e8",
        "types": "#b967ff",
        "variables": "#d7d7e8",
      }
  },
  "terminal.external.osxExec": "WezTerm.app",
}
